@model FinalProjectManager.Data.Models.Supervisor
@{
    ViewData["Title"] = "Изтриване на учител";
}

<h2>Изтриване на учител</h2>
<hr />

<div class="alert alert-danger">
    Сигурни ли сте, че искате да изтриете този учител?
</div>

<dl class="row">
    <dt class="col-sm-3">Пълно име</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Имейл</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@Model.Specialisation?.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn btn-secondary ms-1">Отказ</a>
</form>
