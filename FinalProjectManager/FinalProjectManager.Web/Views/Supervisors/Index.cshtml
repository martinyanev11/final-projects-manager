@model IEnumerable<FinalProjectManager.Data.Models.Supervisor>
@{
    ViewData["Title"] = "Учители";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Учители</h2>
    <a asp-action="Create" class="btn btn-primary">+ Добавяне на учител</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@ViewData["Search"]"
               class="form-control" placeholder="Търсене по иME или имейл..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Търсене</button>
        @if (!string.IsNullOrEmpty(ViewData["Search"]?.ToString()))
        {
            <a asp-action="Index" class="btn btn-outline-danger ms-1">Изчисти</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Не са намерени учители.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Пълно име</th>
                <th>Имейл</th>
                <th>Специализация</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @{ var rowNum = 0; }
            @foreach (var supervisor in Model)
            {
                <tr>
                    <td>@(++rowNum)</td>
                    <td>@supervisor.FullName</td>
                    <td>@supervisor.Email</td>
                    <td>@supervisor.Specialisation?.Name</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@supervisor.Id" class="btn btn-sm btn-outline-info">Детайли</a>
                        <a asp-action="Edit" asp-route-id="@supervisor.Id" class="btn btn-sm btn-outline-warning">Редактиране</a>
                        <a asp-action="Delete" asp-route-id="@supervisor.Id" class="btn btn-sm btn-outline-danger">Изтриване</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
