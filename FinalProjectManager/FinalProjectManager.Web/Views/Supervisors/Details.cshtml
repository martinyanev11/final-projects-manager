@model FinalProjectManager.Data.Models.Supervisor
@{
    ViewData["Title"] = "Детайли за учител";
}

<h2 class="fw-bold mb-1">Детайли за учител</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Пълно Име</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Имейл</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@Model.Specialisation?.Name</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn text-white fw-semibold" style="background-color:#1565c0;">Редактирай</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Назад към списъка</a>
</div>
