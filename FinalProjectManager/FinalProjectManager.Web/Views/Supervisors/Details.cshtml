@model FinalProjectManager.Data.Models.Supervisor
@{
    ViewData["Title"] = "Данни за учител";
}

<h2>Данни за учител</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Пълно име</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Имейл</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@Model.Specialisation?.Name</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактиране</a>
    <a asp-action="Index" class="btn btn-secondary ms-1">Назад към списъка</a>
</div>
