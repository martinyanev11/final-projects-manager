@{
    ViewData["Title"] = "Админ табло";
}

<h2 class="mb-4">Админ табло</h2>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <h5 class="card-title">Теми</h5>
                <p class="card-text text-muted">Управление на дипломни теми — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Topics" asp-action="Index" class="btn btn-primary btn-sm">Управление на теми</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-success">
            <div class="card-body">
                <h5 class="card-title">Ученици</h5>
                <p class="card-text text-muted">Управление на ученически записи — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Students" asp-action="Index" class="btn btn-success btn-sm">Управление на ученици</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-info">
            <div class="card-body">
                <h5 class="card-title">Ръководители</h5>
                <p class="card-text text-muted">Управление на записи на ръководители — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Supervisors" asp-action="Index" class="btn btn-info btn-sm">Управление на ръководители</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-dark">
            <div class="card-body">
                <h5 class="card-title">Разпределения на теми</h5>
                <p class="card-text text-muted">Автоматично разпределяне на теми или ръчна промяна на разпределенията.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Assignments" asp-action="Index" class="btn btn-dark btn-sm">Управление на разпределенията</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-warning">
            <div class="card-body">
                <h5 class="card-title">Чакащи одобрение</h5>
                <p class="card-text text-muted">Преглед и одобряване на заявки за регистрация на ръководители.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-action="PendingApprovals" class="btn btn-warning btn-sm">Преглед на чакащите</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-secondary">
            <div class="card-body">
                <h5 class="card-title">Всички ръководители</h5>
                <p class="card-text text-muted">Преглед на всички регистрирани ръководители и техния статус на одобрение.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-action="AllSupervisors" class="btn btn-secondary btn-sm">Преглед на ръководителите</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-danger">
            <div class="card-body">
                <h5 class="card-title">Специализации</h5>
                <p class="card-text text-muted">Управление на специализации — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Specialisations" asp-action="Index" class="btn btn-danger btn-sm">Управление на специализации</a>
            </div>
        </div>
    </div>
</div>
