@{
    ViewData["Title"] = "Административно табло";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Административно табло</h2>
        <p class="text-muted mb-0 small">Управление на системата за дипломни работи</p>
    </div>
</div>

<div class="row g-4">

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 p-2 me-3" style="background-color:#e3f0fc;">
                        <span style="font-size:1.4rem;">&#128196;</span>
                    </div>
                    <h5 class="card-title mb-0 fw-semibold">Теми</h5>
                </div>
                <p class="card-text text-muted small">Управление на теми за дипломни работи — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Topics" asp-action="Index"
                   class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;">Управление</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 p-2 me-3" style="background-color:#e3f0fc;">
                        <span style="font-size:1.4rem;">&#127891;</span>
                    </div>
                    <h5 class="card-title mb-0 fw-semibold">Ученици</h5>
                </div>
                <p class="card-text text-muted small">Управление на данните на учениците — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Students" asp-action="Index"
                   class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;">Управление</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 p-2 me-3" style="background-color:#e3f0fc;">
                        <span style="font-size:1.4rem;">&#128104;&#8205;&#127979;</span>
                    </div>
                    <h5 class="card-title mb-0 fw-semibold">Учители</h5>
                </div>
                <p class="card-text text-muted small">Управление на учителите и преглед на всички регистрирани учители с техния статус.</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3 d-flex gap-2">
                <a asp-controller="Supervisors" asp-action="Index"
                   class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;">Управление</a>
                <a asp-action="AllSupervisors"
                   class="btn btn-sm btn-outline-secondary fw-semibold">Всички учители</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 p-2 me-3" style="background-color:#e3f0fc;">
                        <span style="font-size:1.4rem;">&#128256;</span>
                    </div>
                    <h5 class="card-title mb-0 fw-semibold">Разпределение</h5>
                </div>
                <p class="card-text text-muted small">Автоматично разпределяне на теми, ръководители и рецензенти на ученици.</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Assignments" asp-action="Index"
                   class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;">Управление</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 p-2 me-3" style="background-color:#fff8e1;">
                        <span style="font-size:1.4rem;">&#9203;</span>
                    </div>
                    <h5 class="card-title mb-0 fw-semibold">Чакащи одобрение</h5>
                </div>
                <p class="card-text text-muted small">Преглед и одобрение на заявки за регистрация от учители.</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-action="PendingApprovals"
                   class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;">Преглед</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 p-2 me-3" style="background-color:#e3f0fc;">
                        <span style="font-size:1.4rem;">&#127991;</span>
                    </div>
                    <h5 class="card-title mb-0 fw-semibold">Специализации</h5>
                </div>
                <p class="card-text text-muted small">Управление на специализациите — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Specialisations" asp-action="Index"
                   class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;">Управление</a>
            </div>
        </div>
    </div>

</div>
