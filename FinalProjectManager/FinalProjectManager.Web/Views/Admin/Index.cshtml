@{
    ViewData["Title"] = "Администраторско табло";
}

<h2 class="mb-4">Администраторско табло</h2>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <h5 class="card-title">Теми</h5>
                <p class="card-text text-muted">Управление на теми — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Topics" asp-action="Index" class="btn btn-primary btn-sm">Управление на теми</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-success">
            <div class="card-body">
                <h5 class="card-title">Ученици</h5>
                <p class="card-text text-muted">Управление на ученици — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Students" asp-action="Index" class="btn btn-success btn-sm">Управление на ученици</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-info">
            <div class="card-body">
                <h5 class="card-title">Учители</h5>
                <p class="card-text text-muted">Управление на учители — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Supervisors" asp-action="Index" class="btn btn-info btn-sm">Управление на учители</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-dark">
            <div class="card-body">
                <h5 class="card-title">Разпределения</h5>
                <p class="card-text text-muted">Автоматично разпределение на теми и ръководители или ръчна промяна.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Assignments" asp-action="Index" class="btn btn-dark btn-sm">Управление на разпределения</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-warning">
            <div class="card-body">
                <h5 class="card-title">Чакащи одобрения</h5>
                <p class="card-text text-muted">Преглед и одобрение на заявки за регистрация на учители.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-action="PendingApprovals" class="btn btn-warning btn-sm">Преглед</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-secondary">
            <div class="card-body">
                <h5 class="card-title">Всички учители</h5>
                <p class="card-text text-muted">Преглед на всички регистрирани учители и техния статус на одобрение.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-action="AllSupervisors" class="btn btn-secondary btn-sm">Преглед на учители</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-danger">
            <div class="card-body">
                <h5 class="card-title">Специализации</h5>
                <p class="card-text text-muted">Управление на специализации — създаване, редактиране и изтриване.</p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="Specialisations" asp-action="Index" class="btn btn-danger btn-sm">Управление на специализации</a>
            </div>
        </div>
    </div>
</div>
