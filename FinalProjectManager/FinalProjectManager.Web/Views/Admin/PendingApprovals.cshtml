@model IEnumerable<FinalProjectManager.Data.Models.ApplicationUser>
@{
    ViewData["Title"] = "Чакащи одобрение";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">Чакащи одобрение</h2>
    <a asp-action="AllSupervisors" class="btn btn-outline-secondary btn-sm">Всички учители</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">Няма чакащи заявки за одобрение.</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Пълно Име</th>
                <th>Имейл</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td class="text-end">
                        <form asp-action="Approve" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-sm text-white" style="background-color:#1565c0;">Одобри</button>
                        </form>
                        <form asp-action="Reject" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Отхвърли и изтрий тази регистрация?')">Отхвърли</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
