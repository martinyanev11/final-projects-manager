@model IEnumerable<FinalProjectManager.Data.Models.ApplicationUser>
@{
    ViewData["Title"] = "Чакащи одобрения на учители";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Чакащи одобрения на учители</h2>
    <a asp-action="AllSupervisors" class="btn btn-outline-secondary btn-sm">Всички учители</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">Няма чакащи одобрения.</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Пълно име</th>
                <th>Имейл</th>
                <th>Регистриран</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>—</td>
                    <td class="text-end">
                        <a asp-action="ReviewApproval" asp-route-userId="@user.Id"
                           class="btn btn-sm btn-warning">Прегледай</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
