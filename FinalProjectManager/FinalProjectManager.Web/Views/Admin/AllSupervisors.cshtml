@model IEnumerable<FinalProjectManager.Data.Models.ApplicationUser>
@{
    ViewData["Title"] = "Всички ръководители";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>All Supervisors</h2>
    <a asp-action="PendingApprovals" class="btn btn-outline-warning btn-sm">Чакащи одобрение</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No supervisors registered yet.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Имейл</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.IsApproved)
                        {
                            <span class="badge bg-success">Одобрен</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Чакащ</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
