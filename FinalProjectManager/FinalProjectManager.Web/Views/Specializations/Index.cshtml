@model IEnumerable<FinalProjectManager.Data.Models.Specialization>
@{
    ViewData["Title"] = "Специалности";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Специалности</h2>
    <a asp-action="Create" class="btn btn-primary">Добави Нова</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Име</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spec in Model)
                {
                    <tr>
                        <td>@spec.Name</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@spec.Id" class="btn btn-sm btn-outline-warning">Редактирай</a>
                            <a asp-action="Delete" asp-route-id="@spec.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
