@model IEnumerable<FinalProjectManager.Data.Models.Student>
@{
    ViewData["Title"] = "Topic Assignments";
    var unassigned = Model.Count(s => s.TopicId == null);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Topic Assignments</h2>
    <form asp-action="AutoAssign" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary"
                onclick="return confirm('Auto-assign topics to all @unassigned unassigned student(s)?')"
                @(unassigned == 0 ? "disabled" : "")>
            Auto-assign (@unassigned unassigned)
        </button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No students in the system yet.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Email</th>
                <th>Assigned Topic</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.FullName</td>
                    <td>@student.Email</td>
                    <td>
                        @if (student.Topic != null)
                        {
                            <span class="badge bg-success">@student.Topic.Title</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Not assigned</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="EditTopic" asp-route-studentId="@student.Id"
                           class="btn btn-sm btn-outline-warning">Change Topic</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
