@model IEnumerable<FinalProjectManager.Data.Models.Student>
@{
    ViewData["Title"] = "Разпределения";
    var unassigned = Model.Count(s => s.TopicId == null);
    var noSupervisor = Model.Count(s => s.SupervisorId == null);
    var noReviewer = Model.Count(s => s.ReviewerId == null && s.SupervisorId != null);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Разпределения</h2>
    <div class="d-flex gap-2">
        <form asp-action="AutoAssign" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary"
                    onclick="return confirm('Авт. разпределение на теми на @unassigned ученик/ученика?')"
                    @(unassigned == 0 ? "disabled" : "")>
                Авт. теми (@unassigned)
            </button>
        </form>
        <form asp-action="AutoAssignSupervisors" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('Авт. разпределение на ръководители на @noSupervisor ученика?')"
                    @(noSupervisor == 0 ? "disabled" : "")>
                Авт. ръководители (@noSupervisor)
            </button>
        </form>
        <form asp-action="AutoAssignReviewers" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-info"
                    onclick="return confirm('Авт. разпределение на рецензенти на @noReviewer ученика?')"
                    @(noReviewer == 0 ? "disabled" : "")>
                Авт. рецензенти (@noReviewer)
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Все още няма ученици в системата.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Ученик</th>
                <th>Специализация</th>
                <th>Присвоена тема</th>
                <th>Ръководител</th>
                <th>Рецензент</th>
                <th class="text-end">Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.FullName</td>
                    <td>@student.Specialisation?.Name</td>
                    <td>
                        @if (student.Topic != null)
                        {
                            <span class="badge bg-success">@student.Topic.Title</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не е присвоено</span>
                        }
                    </td>
                    <td>
                        @if (student.Supervisor != null)
                        {
                            <span class="badge bg-success">@student.Supervisor.FullName</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не е присвоено</span>
                        }
                    </td>
                    <td>
                        @if (student.Reviewer != null)
                        {
                            <span class="badge bg-success">@student.Reviewer.FullName</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не е присвоено</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="EditTopic" asp-route-studentId="@student.Id"
                           class="btn btn-sm btn-outline-warning">Промяна на тема</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
