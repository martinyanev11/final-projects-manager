@model IEnumerable<FinalProjectManager.Data.Models.Student>
@{
    ViewData["Title"] = "Разпределение";
    var unassigned = Model.Count(s => s.TopicId == null);
    var noSupervisor = Model.Count(s => s.SupervisorId == null);
    var noReviewer = Model.Count(s => s.ReviewerId == null && s.SupervisorId != null);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">Разпределение</h2>
    <div class="d-flex gap-2">
        <form asp-action="AutoAssign" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;"
                    onclick="return confirm('Автоматично разпределяне на теми за @unassigned ученик(а)?')"
                    @(unassigned == 0 ? "disabled" : "")>
                Разпредели теми (@unassigned)
            </button>
        </form>
        <form asp-action="AutoAssignSupervisors" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;"
                    onclick="return confirm('Автоматично разпределяне на ръководители за @noSupervisor ученик(а)?')"
                    @(noSupervisor == 0 ? "disabled" : "")>
                Разпредели ръководители (@noSupervisor)
            </button>
        </form>
        <form asp-action="AutoAssignReviewers" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm text-white fw-semibold" style="background-color:#1565c0;"
                    onclick="return confirm('Автоматично разпределяне на рецензенти за @noReviewer ученик(а)?')"
                    @(noReviewer == 0 ? "disabled" : "")>
                Разпредели рецензенти (@noReviewer)
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Все още няма ученици в системата.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Ученик</th>
                <th>Специализация</th>
                <th>Тема</th>
                <th>Ръководител</th>
                <th>Рецензент</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.FullName</td>
                    <td>@student.Specialisation?.Name</td>
                    <td>
                        @if (student.Topic != null)
                        {
                            <span class="badge" style="background-color:#1565c0;">@student.Topic.Title</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не е разпределено</span>
                        }
                    </td>
                    <td>
                        @if (student.Supervisor != null)
                        {
                            <span class="badge" style="background-color:#1565c0;">@student.Supervisor.FullName</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не е разпределено</span>
                        }
                    </td>
                    <td>
                        @if (student.Reviewer != null)
                        {
                            <span class="badge" style="background-color:#1565c0;">@student.Reviewer.FullName</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Не е разпределено</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="EditTopic" asp-route-studentId="@student.Id"
                           class="btn btn-sm btn-outline-warning">Смени тема</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
