@model FinalProjectManager.Data.Models.Specialisation
@{
    ViewData["Title"] = "Specialisation Details";
}

<h2>Specialisation Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Students</dt>
    <dd class="col-sm-9">@Model.Students.Count</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary ms-1">Back to List</a>
</div>
