@model FinalProjectManager.Data.Models.Specialisation
@{
    ViewData["Title"] = "Детайли за специализация";
}

<h2 class="fw-bold mb-1">Детайли за специализация</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Наименование</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Ученици</dt>
    <dd class="col-sm-9">@Model.Students.Count</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn text-white fw-semibold" style="background-color:#1565c0;">Редактирай</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Назад към списъка</a>
</div>
