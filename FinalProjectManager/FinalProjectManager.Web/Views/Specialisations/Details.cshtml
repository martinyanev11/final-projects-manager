@model FinalProjectManager.Data.Models.Specialisation
@{
    ViewData["Title"] = "Данни за специализация";
}

<h2>Данни за специализация</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Наименование</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Ученици</dt>
    <dd class="col-sm-9">@Model.Students.Count</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактиране</a>
    <a asp-action="Index" class="btn btn-secondary ms-1">Назад към списъка</a>
</div>
