@model IEnumerable<FinalProjectManager.Data.Models.Specialisation>
@{
    ViewData["Title"] = "Специализации";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Специализации</h2>
    <a asp-action="Create" class="btn btn-primary">+ Добавяне на специализация</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Не са намерени специализации.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Наименование</th>
                <th>Ученици</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @{ var rowNum = 0; }
            @foreach (var s in Model)
            {
                <tr>
                    <td>@(++rowNum)</td>
                    <td>@s.Name</td>
                    <td>@s.Students.Count</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info">Детайли</a>
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning">Редактиране</a>
                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Изтриване</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
