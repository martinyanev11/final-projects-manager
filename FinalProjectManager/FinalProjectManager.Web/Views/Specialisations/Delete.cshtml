@model FinalProjectManager.Data.Models.Specialisation
@{
    ViewData["Title"] = "Delete Specialisation";
}

<h2>Delete Specialisation</h2>
<hr />

<div class="alert alert-danger">
    Are you sure you want to delete this specialisation?
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Students</dt>
    <dd class="col-sm-9">@Model.Students.Count</dd>
</dl>

@if (Model.Students.Count > 0)
{
    <div class="alert alert-warning">
        This specialisation has @Model.Students.Count student(s) assigned. Reassign or remove them before deleting.
    </div>
}

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger" @(Model.Students.Count > 0 ? "disabled" : "")>Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-1">Cancel</a>
</form>
