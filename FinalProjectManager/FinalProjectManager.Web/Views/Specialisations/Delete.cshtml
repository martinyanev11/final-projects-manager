@model FinalProjectManager.Data.Models.Specialisation
@{
    ViewData["Title"] = "Изтрий специализация";
}

<h2>Изтрий специализация</h2>
<hr />

<div class="alert alert-danger">
    Сигурни ли сте, че искате да изтриете тази специализация?
</div>

<dl class="row">
    <dt class="col-sm-3">Име</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Ученици</dt>
    <dd class="col-sm-9">@Model.Students.Count</dd>
</dl>

@if (Model.Students.Count > 0)
{
    <div class="alert alert-warning">
        Към тази специализация са разпределени @Model.Students.Count ученик/ученици. Прехвърлете ги или ги премахнете преди да изтриете.
    </div>
}

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger" @(Model.Students.Count > 0 ? "disabled" : "")>Изтрий</button>
    <a asp-action="Index" class="btn btn-secondary ms-1">Отказ</a>
</form>
