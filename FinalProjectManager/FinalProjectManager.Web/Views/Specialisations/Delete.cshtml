@model FinalProjectManager.Data.Models.Specialisation
@{
    ViewData["Title"] = "Изтриване на специализация";
}

<h2>Изтриване на специализация</h2>
<hr />

<div class="alert alert-danger">
    Сигурни ли сте, че искате да изтриете тази специализация?
</div>

<dl class="row">
    <dt class="col-sm-3">Наименование</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Ученици</dt>
    <dd class="col-sm-9">@Model.Students.Count</dd>
</dl>

@if (Model.Students.Count > 0)
{
    <div class="alert alert-warning">
        Тази специализация има @Model.Students.Count ученик/ученика. Преместете или изтрийте ги преди да изтриете специализацията.
    </div>
}

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger" @(Model.Students.Count > 0 ? "disabled" : "")>Изтрий</button>
    <a asp-action="Index" class="btn btn-secondary ms-1">Отказ</a>
</form>
