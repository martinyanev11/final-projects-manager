@{
    ViewData["Title"] = "Начало";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Final Project Manager</h1>
    <p class="lead text-muted">Управление на дипломни проекти, ръководители и комисии за защита за СофтУни Будител.</p>
</div>

@if (!User.Identity!.IsAuthenticated)
{
    <div class="row justify-content-center g-3">
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body py-4">
                    <h5 class="card-title">Ученик</h5>
                    <p class="text-muted small">Достъп до вашата дипломна тема и информация за ръководител.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm">Вход</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body py-4">
                    <h5 class="card-title">Ръководител</h5>
                    <p class="text-muted small">Регистрирайте се като ръководител и изчакайте одобрение от администратор.</p>
                    <a asp-controller="SupervisorRegistration" asp-action="Register" class="btn btn-outline-success btn-sm">Регистрация като ръководител</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body py-4">
                    <h5 class="card-title">Админ</h5>
                    <p class="text-muted small">Управлявайте теми, ученици, ръководители и одобрения.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-warning btn-sm">Админ Вход</a>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Admin"))
{
    <div class="text-center">
        <p>Добре дошли отново, <strong>@User.Identity.Name</strong>.</p>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-warning">Към Админ таблото</a>
    </div>
}
else
{
    <div class="text-center">
        <p>Добре дошли отново, <strong>@User.Identity.Name</strong>.</p>
    </div>
}
