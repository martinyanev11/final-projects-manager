@{
    ViewData["Title"] = "Начало";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Управление на Дипломни Проекти</h1>
    <p class="lead text-muted">Система за управление на теми, ръководители и защити.</p>
</div>

@if (!User.Identity!.IsAuthenticated)
{
    <div class="row justify-content-center g-3">
        <div class="col-md-5">
            <div class="card text-center h-100 shadow-sm border-primary">
                <div class="card-body py-5">
                    <h2 class="card-title mb-3">Добре дошли</h2>
                    <p class="text-muted mb-4">Влезте в системата или се регистрирайте като ученик или учител.</p>
                    <div class="d-grid gap-2 d-md-block">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary px-4">Вход</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary px-4">Регистрация</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Admin"))
{
    <div class="text-center">
        <p class="lead">Добре дошли отново, <strong>@User.Identity.Name</strong>!</p>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-warning btn-lg px-5 shadow">Към Админ Таблото</a>
    </div>
}
else
{
    <div class="text-center">
        <p class="lead">Добре дошли отново, <strong>@User.Identity.Name</strong>!</p>
        <p class="text-muted">Можете да прегледате вашата информация от менюто горе.</p>
    </div>
}
