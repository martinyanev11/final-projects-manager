@model FinalProjectManager.Data.Models.Student?
@{
    ViewData["Title"] = "Начало";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Управление на дипломни проекти</h1>
    <p class="lead text-muted">Система за управление на дипломни работи, ръководители и комисии за защита — СофтУни Будител.</p>
</div>

@if (!User.Identity!.IsAuthenticated)
{
    <div class="row justify-content-center g-3">
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body py-4">
                    <h5 class="card-title">Ученик</h5>
                    <p class="text-muted small">Достъп до твоята тема за дипломна работа и ръководител.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm">Вход</a>
                    <a asp-controller="StudentRegistration" asp-action="Register" class="btn btn-outline-secondary btn-sm ms-1">Регистрация</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body py-4">
                    <h5 class="card-title">Учител</h5>
                    <p class="text-muted small">Вход или регистрация като учител. Акаунтът се одобрява от администратор.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-success btn-sm">Вход</a>
                    <a asp-controller="SupervisorRegistration" asp-action="Register" class="btn btn-outline-secondary btn-sm ms-1">Регистрация</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body py-4">
                    <h5 class="card-title">Администратор</h5>
                    <p class="text-muted small">Управление на теми, ученици, учители и разпределения.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-warning btn-sm">Вход</a>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Admin"))
{
    <div class="text-center">
        <p>Добре дошъл, <strong>@User.Identity.Name</strong>.</p>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-warning">Към администраторското табло</a>
    </div>
}
else if (User.IsInRole("Student"))
{
    <p class="text-center mb-4">Добре дошъл, <strong>@(Model?.FullName ?? User.Identity?.Name)</strong>.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📄 Дипломна тема</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    @if (Model?.Topic != null)
                    {
                        <h5 class="card-title">@Model.Topic.Title</h5>
                        @if (!string.IsNullOrWhiteSpace(Model.Topic.Description))
                        {
                            <p class="text-muted small">@Model.Topic.Description</p>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <div class="fs-1 mb-2">⏳</div>
                            <p class="mb-0">Очаква се присвояване на тема.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">👩‍🏫 Учители и комисия</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Ръководител</dt>
                        <dd class="col-sm-7">
                            @if (Model?.Supervisor != null)
                            {
                                <span class="fw-semibold">@Model.Supervisor.FullName</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic small">Очаква се присвояване</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted">Рецензент</dt>
                        <dd class="col-sm-7">
                            @if (Model?.Reviewer != null)
                            {
                                <span class="fw-semibold">@Model.Reviewer.FullName</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic small">Очаква се присвояване</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted">Комисия за защита</dt>
                        <dd class="col-sm-7">
                            @if (Model?.Committee != null)
                            {
                                <span class="fw-semibold">@Model.Committee.Name</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic small">Очаква се присвояване</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center">
        <p>Добре дошъл, <strong>@User.Identity.Name</strong>.</p>
    </div>
}
