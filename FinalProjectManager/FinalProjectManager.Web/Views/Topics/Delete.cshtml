@model FinalProjectManager.Data.Models.Topic
@{
    ViewData["Title"] = "Изтрий тема";
}

<h2 class="fw-bold mb-1">Изтрий тема</h2>
<hr />

<div class="alert alert-danger">
    Сигурни ли сте, че искате да изтриете тази тема?
</div>

<dl class="row">
    <dt class="col-sm-3">Заглавие</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@Model.Specialisation?.Name</dd>

    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Отказ</a>
</form>
