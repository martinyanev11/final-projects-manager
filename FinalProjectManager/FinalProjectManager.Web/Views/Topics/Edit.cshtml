@model FinalProjectManager.Data.Models.Topic
@{
    ViewData["Title"] = "Редактирай тема";
}

<h2>Edit Topic</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SpecialisationId" class="form-label">Специализация</label>
                <select asp-for="SpecialisationId" asp-items="ViewBag.Specialisations" class="form-select">
                    <option value="">— Select specialisation —</option>
                </select>
                <span asp-validation-for="SpecialisationId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">Запази</button>
            <a asp-action="Index" class="btn btn-secondary ms-1">Отказ</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
