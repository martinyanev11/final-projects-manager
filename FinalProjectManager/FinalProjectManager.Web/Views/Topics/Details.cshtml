@model FinalProjectManager.Data.Models.Topic
@{
    ViewData["Title"] = "Детайли за тема";
}

<h2>Topic Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Заглавие</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@Model.Specialisation?.Name</dd>

    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактирай</a>
    <a asp-action="Index" class="btn btn-secondary ms-1">Обратно към списъка</a>
</div>
