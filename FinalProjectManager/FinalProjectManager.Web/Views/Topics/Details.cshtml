@model FinalProjectManager.Data.Models.Topic
@{
    ViewData["Title"] = "Topic Details";
}

<h2>Topic Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Specialisation</dt>
    <dd class="col-sm-9">@Model.Specialisation?.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary ms-1">Back to List</a>
</div>
