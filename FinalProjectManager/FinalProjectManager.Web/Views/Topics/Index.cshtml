@model IEnumerable<FinalProjectManager.Data.Models.Topic>
@{
    ViewData["Title"] = "Теми";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Thesis Topics</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Topic</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@ViewData["Search"]"
               class="form-control" placeholder="Search topics..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Търсене</button>
        @if (!string.IsNullOrEmpty(ViewData["Search"]?.ToString()))
        {
            <a asp-action="Index" class="btn btn-outline-danger ms-1">Изчисти</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No topics found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Заглавие</th>
                <th>Специализация</th>
                <th>Описание</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var topic in Model)
            {
                <tr>
                    <td>@topic.Id</td>
                    <td>@topic.Title</td>
                    <td>@topic.Specialisation?.Name</td>
                    <td>@(topic.Description?.Length > 60 ? topic.Description[..60] + "…" : topic.Description)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-info">Детайли</a>
                        <a asp-action="Edit" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-warning">Редактирай</a>
                        <a asp-action="Delete" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
